{
    "name": "blokkli/drupal",
    "description": "The Drupal site behind the blökkli playground and sandbox.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "name": "paragraphs_blokkli",
            "type": "path",
            "url": "paragraphs_blokkli",
            "options": {
                "symlink": true,
                "versions": {
                    "drupal/paragraphs_blokkli": "2.0.x-dev"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7",
        "deeplcom/deepl-php": "^1.18",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/graphql": "^5",
        "drupal/graphql_core_schema": "^1.0",
        "drupal/masquerade": "^2.0@beta",
        "drupal/office_hours": "^1.29",
        "drupal/paragraphs": "^1.23",
        "drupal/paragraphs_blokkli": "2.0.x-dev",
        "drupal/scheduler": "^2.3",
        "drupal/search_api": "^1.41",
        "drupal/translatable_config_pages": "^1.0",
        "drush/drush": "^13",
        "twig/twig": "~3.29.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "symfony/runtime": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.editorconfig": false,
                "[project-root]/.gitattributes": false,
                "[project-root]/recipes/README.txt": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/scheduler": {
                "scheduler#3312200: Paragraph scheduler plugin": "https://www.drupal.org/files/issues/2026-06-15/3312200-paragraph-scheduler.diff"
            }
        }
    }
}
