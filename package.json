{
  "name": "@blokkli/editor",
  "version": "2.0.0-alpha.58",
  "description": "Interactive page building experience for Nuxt",
  "keywords": [
    "cms",
    "drag-and-drop",
    "editor",
    "nuxt",
    "nuxt-module",
    "page-builder",
    "vue",
    "wysiwyg"
  ],
  "homepage": "https://blokk.li",
  "bugs": {
    "url": "https://github.com/blokkli/editor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Hug",
    "email": "me@dulnan.net",
    "url": "https://dulnan.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokkli/editor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "drupal": [
        "./dist/modules/drupal/index.d.mts"
      ],
      "agent": [
        "./dist/modules/agent/index.d.mts"
      ],
      "table-of-contents": [
        "./dist/modules/table-of-contents/index.d.mts"
      ],
      "charts": [
        "./dist/modules/charts/index.d.mts"
      ],
      "iframes": [
        "./dist/modules/iframes/index.d.mts"
      ],
      "modules": [
        "./dist/modules/index.d.mts"
      ],
      "tailwind": [
        "./dist/modules/tailwind/index.d.mts"
      ],
      "readability": [
        "./dist/modules/readability/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./drupal": {
      "types": "./dist/modules/drupal/index.d.mts",
      "import": "./dist/modules/drupal/index.mjs"
    },
    "./agent": {
      "types": "./dist/modules/agent/index.d.mts",
      "import": "./dist/modules/agent/index.mjs"
    },
    "./table-of-contents": {
      "types": "./dist/modules/table-of-contents/index.d.mts",
      "import": "./dist/modules/table-of-contents/index.mjs"
    },
    "./charts": {
      "types": "./dist/modules/charts/index.d.mts",
      "import": "./dist/modules/charts/index.mjs"
    },
    "./iframes": {
      "types": "./dist/modules/iframes/index.d.mts",
      "import": "./dist/modules/iframes/index.mjs"
    },
    "./modules": {
      "types": "./dist/modules/index.d.mts",
      "import": "./dist/modules/index.mjs"
    },
    "./tailwind": {
      "types": "./dist/modules/tailwind/index.d.mts",
      "require": "./dist/modules/tailwind/index.mjs",
      "import": "./dist/modules/tailwind/index.mjs"
    },
    "./readability": {
      "types": "./dist/modules/readability/index.d.mts",
      "require": "./dist/modules/readability/index.mjs",
      "import": "./dist/modules/readability/index.mjs"
    }
  },
  "scripts": {
    "prepack": "rm -rf dist && nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f && npx tsx scripts/mangle-dist.ts",
    "dev": "nuxi dev playground --host",
    "typecheck": "npm run typecheck:build && npm run typecheck:runtime && npm run typecheck:server && npm run typecheck:playground",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "typecheck:playground": "vue-tsc --noEmit -p ./playground/.nuxt/tsconfig.app.json",
    "dev:minimal": "nuxi dev playground-minimal --host",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css --watch",
    "dev:build": "npm run changelog && npm run dev:prepare && nuxi generate playground",
    "dev:build-ssr": "npm run dev:prepare && nuxt build playground",
    "dev:start": "npx serve playground/.output/public",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "dev:analyze": "npx nuxt analyze playground",
    "release": "npm run lint && npm run prepack && changelogen --release",
    "changelog": "node ./scripts/changelog/index.cjs",
    "texts": "node ./scripts/texts/index.cjs",
    "material-icons": "node ./scripts/material-icons/index.cjs",
    "lint": "npx oxlint && eslint ./src",
    "lint:fix": "npx oxlint --fix && eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@material-symbols/svg-600": "0.40.2",
    "@tiptap/extension-emoji": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "apexcharts": "^5.4.0",
    "artboard-deluxe": "^0.1.5",
    "estree-walker-ts": "^1.1.0",
    "fzf": "^0.5.2",
    "get-video-id": "^4.1.7",
    "html-diff-ts": "^1.4.2",
    "marked": "^17.0.1",
    "mitt": "^3.0.1",
    "papaparse": "^5.5.3",
    "pofile": "^1.1.4",
    "qrcode.vue": "^3.6.0",
    "twgl.js": "^7.0.0",
    "vue3-apexcharts": "^1.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.12.1",
    "@nuxt/kit": "^4.4.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.4",
    "@nuxt/test-utils": "^3.21.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/gettext-parser": "^8.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.0.3",
    "@types/papaparse": "^5.5.2",
    "@types/turndown": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.0",
    "changelogen": "^0.6.2",
    "ckeditor5": "^47.3.0",
    "commander": "^13.1.0",
    "cypress": "^15.8.1",
    "deepl-node": "^1.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.35.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "gettext-parser": "^8.0.0",
    "happy-dom": "^20.0.11",
    "nuxt": "^4.4.4",
    "nuxt-graphql-middleware": "^5.3.0",
    "nuxt-svg-icon-sprite": "^2.0.2",
    "openai": "^6.17.0",
