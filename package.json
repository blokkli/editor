{
  "name": "@blokkli/editor",
  "version": "2.0.0-alpha.31",
  "description": "Interactive page building experience for Nuxt",
  "keywords": [
    "cms",
    "drag-and-drop",
    "editor",
    "nuxt",
    "nuxt-module",
    "page-builder",
    "vue",
    "wysiwyg"
  ],
  "homepage": "https://blokk.li",
  "bugs": {
    "url": "https://github.com/blokkli/editor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Hug",
    "email": "me@dulnan.net",
    "url": "https://dulnan.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokkli/editor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "drupal": [
        "./dist/modules/drupal/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./drupal": {
      "types": "./dist/modules/drupal/index.d.mts",
      "import": "./dist/modules/drupal/index.mjs"
    }
  },
  "scripts": {
    "prepack": "rm -rf dist && nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f",
    "dev": "nuxi dev playground --host",
    "typecheck": "npm run typecheck:build && npm run typecheck:runtime && npm run typecheck:playground",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:playground": "cd playground && vue-tsc --noEmit",
    "dev:minimal": "nuxi dev playground-minimal --host",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css --watch",
    "dev:build": "npm run dev:prepare && nuxi generate playground",
    "dev:start": "npx serve playground/.output/public",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prepack && changelogen --release",
    "texts": "node ./scripts/texts/index.cjs",
    "material-icons": "node ./scripts/material-icons/index.cjs",
    "lint": "npx oxlint && eslint ./src",
    "lint:fix": "npx oxlint --fix && eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@material-symbols/svg-600": "0.40.2",
    "@nuxt/kit": "^4.2.2",
    "artboard-deluxe": "0.1.3",
    "estree-walker-ts": "^1.1.0",
    "fzf": "^0.5.2",
    "get-video-id": "^4.1.7",
    "html-diff-ts": "^1.4.2",
    "mitt": "^3.0.1",
    "qrcode.vue": "^3.6.0",
    "twgl.js": "^7.0.0"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@lunarisapp/readability": "^1.0.2",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.12.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.2",
    "@nuxt/test-utils": "^3.21.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/gettext-parser": "^8.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.0.3",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.0",
    "changelogen": "^0.6.2",
    "ckeditor5": "^47.3.0",
    "cypress": "^15.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.35.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "gettext-parser": "^8.0.0",
    "happy-dom": "^20.0.11",
    "nuxt": "^4.2.2",
    "nuxt-graphql-middleware": "^5.3.0",
    "nuxt-svg-icon-sprite": "^2.0.2",
    "openai": "^5.13.1",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "playwright-core": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested-import": "^1.3.0",
    "postcss-replace": "^2.0.1",
    "postcss-url": "^10.1.3",
    "prettier": "^3.7.4",
    "prettier-plugin-glsl": "^0.2.2",
    "tailwindcss": "^3.4.17",
    "unbuild": "^3.6.1",
    "vite-plugin-glsl": "^1.5.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.8"
  },
  "peerDependencies": {
    "@lunarisapp/readability": "^1.0.2",
    "axe-core": "^4.10.0",
    "magic-string": "^0.30.0",
    "micromatch": "^4.0.0",
    "oxc-walker": "^0.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@lunarisapp/readability": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
