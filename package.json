    "postcss-url": "^10.1.3",
    "prettier": "^3.7.4",
    "prettier-plugin-glsl": "^0.2.5",
    "syllable": "^5.0.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.0",
    "unbuild": "^3.6.1",
    "vite-plugin-glsl": "^1.5.5",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.8"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "@thedutchcoder/postcss-rem-to-px": "*",
