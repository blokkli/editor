{
  "name": "@blokkli/editor",
  "version": "2.0.0-alpha.15",
  "description": "Interactive page building experience for Nuxt",
  "repository": "blokkli/editor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./drupal": "./dist/modules/drupal/index.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "drupal": [
        "./dist/modules/drupal/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "rm -rf dist && nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f",
    "dev": "nuxi dev playground --host",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "dev:minimal": "nuxi dev playground-minimal --host",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/css/output.css --watch",
    "dev:build": "npm run dev:prepare && nuxi generate playground",
    "dev:start": "npx serve playground/.output/public",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prepack && changelogen --release",
    "texts": "node ./scripts/texts/index.cjs",
    "drupal-types": "node ./scripts/drupal/index.cjs",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "cypress:open": "cypress open"
  },
  "author": {
    "name": "Jan Hug",
    "url": "https://dulnan.net",
    "email": "me@dulnan.net"
  },
  "license": "MIT",
  "dependencies": {
    "@types/micromatch": "^4.0.9",
    "artboard-deluxe": "^0.1.2",
    "estree-walker-ts": "^1.1.0",
    "flesch": "^2.0.1",
    "fzf": "^0.5.2",
    "get-video-id": "^4.1.7",
    "html-diff-ts": "^1.4.2",
    "hyphen": "^1.10.6",
    "mitt": "^3.0.1",
    "parse-latin": "^7.0.0",
    "qrcode.vue": "^3.6.0",
    "twgl.js": "^7.0.0"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-build-classic": "^44.3.0",
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@lunarisapp/readability": "^1.0.2",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/kit": "^4.1.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.1.2",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@types/gettext-parser": "^8.0.0",
    "@types/hyphen": "^1.6.7",
    "@types/node": "^24.3.0",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.3",
    "changelogen": "^0.6.2",
    "cypress": "^15.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "gettext-parser": "^8.0.0",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.1.2",
    "nuxt-graphql-middleware": "^5.2.1",
    "nuxt-svg-icon-sprite": "^2.0.2",
    "openai": "^5.13.1",
    "oxc-walker": "^0.5.2",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested-import": "^1.3.0",
    "postcss-replace": "^2.0.1",
    "postcss-url": "^10.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-glsl": "^0.2.2",
    "tailwindcss": "^3.4.17",
    "unbuild": "^3.6.1",
    "vite-plugin-glsl": "^1.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "@lunarisapp/readability": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@lunarisapp/readability": {
      "optional": true
    }
  }
}
