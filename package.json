{
  "name": "@blokkli/editor",
  "version": "2.0.0-alpha.71",
  "description": "Interactive page building experience for Nuxt",
  "keywords": [
    "cms",
    "drag-and-drop",
    "editor",
    "nuxt",
    "nuxt-module",
    "page-builder",
    "vue",
    "wysiwyg"
  ],
  "homepage": "https://blokk.li",
  "bugs": {
    "url": "https://github.com/blokkli/editor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Hug",
    "email": "me@dulnan.net",
    "url": "https://dulnan.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokkli/editor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "drupal": [
        "./dist/modules/drupal/index.d.mts"
      ],
      "agent": [
        "./dist/modules/agent/index.d.mts"
      ],
      "table-of-contents": [
        "./dist/modules/table-of-contents/index.d.mts"
      ],
      "charts": [
        "./dist/modules/charts/index.d.mts"
      ],
      "iframes": [
        "./dist/modules/iframes/index.d.mts"
      ],
      "modules": [
        "./dist/modules/index.d.mts"
      ],
      "tailwind": [
        "./dist/modules/tailwind/index.d.mts"
      ],
      "readability": [
        "./dist/modules/readability/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./drupal": {
      "types": "./dist/modules/drupal/index.d.mts",
      "import": "./dist/modules/drupal/index.mjs"
    },
    "./agent": {
      "types": "./dist/modules/agent/index.d.mts",
      "import": "./dist/modules/agent/index.mjs"
    },
    "./table-of-contents": {
      "types": "./dist/modules/table-of-contents/index.d.mts",
      "import": "./dist/modules/table-of-contents/index.mjs"
    },
    "./charts": {
      "types": "./dist/modules/charts/index.d.mts",
      "import": "./dist/modules/charts/index.mjs"
    },
    "./iframes": {
      "types": "./dist/modules/iframes/index.d.mts",
      "import": "./dist/modules/iframes/index.mjs"
    },
    "./modules": {
      "types": "./dist/modules/index.d.mts",
      "import": "./dist/modules/index.mjs"
    },
    "./tailwind": {
      "types": "./dist/modules/tailwind/index.d.mts",
      "require": "./dist/modules/tailwind/index.mjs",
      "import": "./dist/modules/tailwind/index.mjs"
    },
    "./readability": {
      "types": "./dist/modules/readability/index.d.mts",
      "require": "./dist/modules/readability/index.mjs",
      "import": "./dist/modules/readability/index.mjs"
    }
  },
  "scripts": {
    "prepack": "rm -rf dist && nuxt-module-build build && bunx tsx scripts/mangle-dist.ts",
    "dev": "nuxi dev playground --host",
    "typecheck": "bun run typecheck:build && bun run typecheck:runtime && bun run typecheck:server && bun run typecheck:playground",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "typecheck:playground": "vue-tsc --noEmit -p ./playground/.nuxt/tsconfig.app.json",
    "dev:minimal": "nuxi dev playground-minimal --host",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/editor/css/output.css --watch",
    "dev:build": "bun run changelog && bun run dev:prepare && nuxi generate playground",
    "dev:build-ssr": "PLAYGROUND_SSR_BUILD=true nuxt build playground",
    "dev:start": "bunx serve playground/.output/public",
    "dev:start-ssr": "cd playground && node -r dotenv/config ./.output/server/index.mjs",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "dev:analyze": "bunx nuxt analyze playground",
    "release": "bun run lint && bun run prepack && changelogen --release",
    "changelog": "node ./scripts/changelog/index.cjs",
    "texts": "node ./scripts/texts/index.cjs",
    "material-icons": "node ./scripts/material-icons/index.cjs",
    "lint": "bunx oxlint && eslint ./src",
    "lint:fix": "bunx oxlint --fix && eslint ./src --fix",
    "test": "bun run test:unit && bun run test:e2e",
    "test:watch": "vitest watch --project unit --project e2e --no-file-parallelism",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest watch --project unit",
    "test:e2e": "vitest run --project e2e",
    "format": "oxfmt --check && prettier '**/*.graphql' --check",
    "format:fix": "oxfmt --write && prettier '**/*.graphql' --write",
    "verify": "bash ./scripts/verify.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@material-symbols/svg-600": "0.45.1",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-emoji": "^3.26.1",
    "@tiptap/extension-mention": "^3.26.1",
    "@tiptap/extension-task-item": "^3.26.1",
    "@tiptap/extension-task-list": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "artboard-deluxe": "^0.1.5",
    "echarts": "^6.1.0",
    "estree-walker-ts": "^1.1.0",
    "fzf": "^0.5.2",
    "get-video-id": "^4.2.0",
    "html-diff-ts": "^1.4.2",
    "json5": "^2.2.3",
    "marked": "^18.0.5",
    "mitt": "^3.0.1",
    "papaparse": "^5.5.3",
    "pofile": "^1.1.4",
    "qrcode.vue": "^3.10.0",
    "twgl.js": "^7.0.0",
    "vue-echarts": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@ckeditor/ckeditor5-vue": "^8.1.1",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/kit": "^4.4.8",
    "@nuxt/module-builder": "^1.0.2",
