msgctxt "templatesAddTemplateDescription"
msgid ""
"<p>Drag the icon into the page to add blocks from a "
"template.</p><p>Templates are copied to your page and can be changed "
"without affecting other pages.</p>"
msgstr ""
"<p>Ziehen Sie das Symbol auf die Seite, um Blöcke aus einer Vorlage "
"hinzuzufügen.</p>"

