#!/usr/bin/env bash

## Description: Deploy the hosted sandbox: update the code, build the Nuxt apps, bake the templates, update premium sandboxes, delete the others, restart
## Usage: deploy
## Example: "ddev deploy"

# Only on the hosted instance (IS_DDEV_HOSTED=true, a project_tld of its own).
# It moves the checked-out branch to GitHub's, even when that was rewritten,
# updates the submodule and replaces the site's database: locally that would
# undo work in progress. Run it again every week or so, so that the seeded
# dates (relative to the bake) stay current.
#
# The running Nuxt apps keep serving while the new ones are built and the
# templates baked, so a failed build or bake leaves them running. Drupal runs
# the new code from the update on.
#
# Premium sandboxes (lifetime.json, "premium": true) keep their content and
# files. The control app reads that file. `drush deploy` runs database
# updates and config import on each one. Every other sandbox is deleted. The
# control app's cleanup marks those rows deleted; a premium sandbox's row and
# access links stay. A failed update stops the deploy; run it again.

set -euo pipefail

cd "$DDEV_APPROOT"

fail() {
  echo "ddev deploy: $1" >&2
  exit 1
}

# The checks read the web container's environment, so the project must run.
web_env() {
  ddev exec printenv "$1" 2>/dev/null | tr -d '\r' || true
}

[ "$(web_env IS_DDEV_HOSTED)" = true ] ||
  fail "this isn't the hosted instance (IS_DDEV_HOSTED=true in .ddev/config.local.yaml), or the project doesn't run (ddev start)."

# nginx tells the local site from the hosted one by the domain (ddev.site).
case ",$(web_env DDEV_HOSTNAME)," in
  *.ddev.site,*) fail "the hostnames are ddev.site ones: set project_tld to the hosted domain in .ddev/config.local.yaml." ;;
esac

# settings.php and the control app refuse to run without them.
for variable in DRUPAL_HASH_SALT NUXT_SANDBOX_LOGIN_SECRET NUXT_ADMIN_PASSWORD; do
  [ -n "$(web_env "$variable")" ] || fail "$variable isn't set (.ddev/.env.web)."
done

# Two deploys at once bake into the same database: one deletes it while the
# other seeds ("there's no taxonomy_term type …"). The GitHub workflow and the
# weekly cron job wait for each other under their own lock
# (/tmp/blokkli-deploy.lock); this one makes any second deploy give up.
exec 9>/tmp/blokkli-deploy-running.lock
flock -n 9 || fail "another deploy is running."

# The Nuxt apps that this deploy stopped. If it fails, it starts them again.
stopped=()

nuxt_app() {
  if [ "$1" = control ]; then
    ddev nuxt control "$2"
  else
    ddev nuxt "$2"
  fi
}

stop_app() {
  # Stopping one that doesn't run fails.
  nuxt_app "$1" stop || true
  stopped+=("$1")
}

restart_stopped() {
  local status=$?
  if [ "$status" -ne 0 ] && [ "${#stopped[@]}" -gt 0 ]; then
    echo "ddev deploy: failed, starting the Nuxt apps again." >&2
    for app in "${stopped[@]}"; do
      nuxt_app "$app" start || true
    done
  fi
}
trap restart_stopped EXIT

echo "== Code"
git fetch origin
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')
if ! git merge --ff-only "$upstream"; then
  # The branch was rewritten (an amend, a rebase). Nobody works or commits in
  # this checkout, so it takes GitHub's, unless something was changed here.
  git diff --quiet HEAD ||
    fail "the checkout has local changes, and $upstream can't be fast-forwarded to."
  echo "$upstream was rewritten: resetting to it."
  git reset --hard "$upstream"
fi
git submodule update --init

# The running apps don't need either: their builds are self-contained.
echo "== Dependencies"
ddev composer install --no-interaction
ddev exec -d /var/www/html bun install --frozen-lockfile

# Next to the running builds (.output), which the swap below replaces.
echo "== Building the Nuxt apps"
for app in frontend control; do
  rm -rf "sandbox/$app/.output-next"
done
ddev exec -d /var/www/html env SANDBOX_OUTPUT_DIR=.output-next bun run sandbox:build

# The control app hands out sandboxes, which are copies of the templates.
echo "== Stopping the claim page"
stop_app control

# Every language with a template. The default site is only what the templates
# are made of: nginx doesn't serve it when hosted.
echo "== Baking the templates"
ddev bake --source=de
ddev bake --source=fr
ddev bake

# nginx shows its 502 page from here on.
echo "== Swapping in the new builds"
stop_app frontend
for app in frontend control; do
  rm -rf "sandbox/$app/.output"
  mv "sandbox/$app/.output-next" "sandbox/$app/.output"
done

# Premium sandboxes keep their content. The control app reads lifetime.json,
# the same flag as the agent. An unreadable file fails that read, so the
# deploy stops with every sandbox still there. The others are copies of the
# old templates.
echo "== Sandboxes"
sandboxes=$(ddev drush blokkli-sandbox:list --format=tsv --fields=id,url | tr -d '\r')
premium=$(ddev exec -d /var/www/html bun sandbox/control/scripts/premium-sandboxes.ts | tr -d '\r')
if [ -n "$sandboxes" ]; then
  while IFS=$'\t' read -r id url; do
    [ -n "$id" ] || continue
    if [[ $'\n'$premium$'\n' == *$'\n'$id$'\n'* ]]; then
      echo "Updating the premium sandbox $id."
      ddev drush --uri="$url" deploy -y
    else
      ddev drush blokkli-sandbox:delete "$id"
    fi
  done <<< "$sandboxes"
fi

# nginx's config, and the Nuxt apps with their new builds.
echo "== Restarting"
ddev restart
stopped=()

echo "Deployed $(git rev-parse --short HEAD) (paragraphs_blokkli $(git -C sandbox/drupal/paragraphs_blokkli rev-parse --short HEAD))."
