#!/usr/bin/env bash

## Description: Check which upstream (nuxt, drupal, control) nginx routes paths to
## Usage: check-routes
## Example: "ddev check-routes"

# Every path in the tables below is requested through the ddev router, and the
# X-Blokkli-Upstream response header (set in .ddev/nginx_full/nginx-site.conf)
# is compared with the expected upstream. Extend the table when routes change:
# a module or view with a new first path segment needs it in the nginx list.

set -uo pipefail

base="${DDEV_PRIMARY_URL:-https://blokkli.ddev.site}"

routes=(
  # Nuxt
  "/ nuxt"
  "/en/some/page nuxt"
  "/de nuxt"
  "/node/1 nuxt"
  "/_nuxt/x.js nuxt"
  "/api/graphql_middleware/x nuxt"
  "/api/blokkli/agent nuxt"
  "/blockchain nuxt"
  "/users nuxt"
  "/media-kit nuxt"
  "/administration nuxt"
  "/en/blokkli/library-item/x nuxt"
  "/de/search nuxt"
  "/en/blokkli/template/x nuxt"
  # Drupal
  "/user/login drupal"
  "/fr/user/login drupal"
  "/graphql drupal"
  "/en/graphql drupal"
  "/de/graphql drupal"
  "/admin drupal"
  "/de/admin/content drupal"
  "/core/install.php drupal"
  "/update.php drupal"
  "/node/add drupal"
  "/node/add/page drupal"
  "/node/1/edit drupal"
  "/fr/node/1/translations drupal"
  "/node/preview/x/full drupal"
  "/taxonomy/term/1/edit drupal"
  "/media/1/edit drupal"
  "/media-library drupal"
  "/media/oembed drupal"
  "/paragraphs_blokkli/x drupal"
  "/paragraphs_blokkli_graphql/prefix drupal"
  "/admin/config/content/blokkli drupal"
  "/layout_builder/x drupal"
  "/file/progress/1 drupal"
  "/sites/default/files/x.jpg drupal"
  "/system/files/x drupal"
  "/entity_reference_autocomplete/x drupal"
  "/.well-known/change-password drupal"
  "/blokkli-sandbox/login/x drupal"
)

# A sandbox that doesn't exist: nginx's static page, whatever the path.
unknown_sandbox="${base/:\/\//://zz99.}"
sandbox_routes=(
  "/ sandbox-unknown"
  "/en/graphql sandbox-unknown"
  "/_nuxt/x.js sandbox-unknown"
)

# Files, with the expected status: a sandbox's files only on its own host (none
# on the default site), and PHP never runs from them.
file_routes=(
  "/sites/default/files/sandboxes/zz98/x.jpg nginx 404"
  "/sites/default/files/x.php drupal 403"
)

# The control app: every path, Drupal's included.
control="${base/:\/\/blokkli./://blokkli-control.}"
control_routes=(
  "/ control"
  "/de control"
  "/admin control"
  "/api/claim control"
  "/user/login control"
)

failed=0
# Compares the upstream and, if given, the status.
check() {
  local url="$1" expected="$2" status="${3:-}" headers actual code
  headers=$(curl -sk -o /dev/null -D - --max-time 10 "$url" | tr -d '\r')
  actual=$(awk -F': ' 'tolower($1) == "x-blokkli-upstream" { print $2 }' <<<"$headers")
  code=$(awk 'NR == 1 { print $2 }' <<<"$headers")
  if [ "$actual" = "$expected" ] && { [ -z "$status" ] || [ "$code" = "$status" ]; }; then
    printf '  ok    %-50s %s\n' "${url#https://}" "$actual${status:+ $code}"
  else
    printf '  FAIL  %-50s expected %s, got %s\n' "${url#https://}" "$expected${status:+ $status}" "${actual:-nothing}${status:+ $code}"
    failed=1
  fi
}

for route in "${routes[@]}"; do
  check "$base${route% *}" "${route##* }"
done
for route in "${file_routes[@]}"; do
  read -r path upstream status <<<"$route"
  check "$base$path" "$upstream" "$status"
done
for route in "${sandbox_routes[@]}"; do
  check "$unknown_sandbox${route% *}" "${route##* }"
done
for route in "${control_routes[@]}"; do
  check "$control${route% *}" "${route##* }"
done

exit $failed
