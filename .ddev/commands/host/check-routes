#!/usr/bin/env bash

## Description: Check which upstream (nuxt, drupal, control) nginx routes paths to
## Usage: check-routes
## Example: "ddev check-routes"

# Every path in the tables below is requested through the ddev router, and the
# X-Blokkli-Upstream response header (set in .ddev/nginx_full/nginx-site.conf)
# is compared with the expected upstream. Extend the table when routes change:
# a module or view with a new first path segment needs it in the nginx list.

set -uo pipefail

base="${DDEV_PRIMARY_URL:-https://blokkli.ddev.site}"

routes=(
  # Nuxt
  "/ nuxt"
  "/en/some/page nuxt"
  "/de nuxt"
  "/node/1 nuxt"
  "/_nuxt/x.js nuxt"
  "/api/graphql_middleware/x nuxt"
  "/api/blokkli/agent nuxt"
  "/blockchain nuxt"
  "/users nuxt"
  "/media-kit nuxt"
  "/administration nuxt"
  "/index.php/graphql nuxt"
  "/en/index.php/node/1 nuxt"
  "/x.php nuxt"
  "/en/blokkli/library-item/x nuxt"
  "/de/search nuxt"
  "/en/blokkli/template/x nuxt"
  # Drupal
  "/user/login drupal"
  "/fr/user/login drupal"
  "/graphql drupal"
  "/en/graphql drupal"
  "/de/graphql drupal"
  "/admin drupal"
  "/de/admin/content drupal"
  "/core/install.php drupal"
  "/index.php drupal"
  "/update.php drupal"
  "/update.php/selection drupal"
  "/node/add drupal"
  "/node/add/page drupal"
  "/node/1/edit drupal"
  "/fr/node/1/translations drupal"
  "/node/preview/x/full drupal"
  "/taxonomy/term/1/edit drupal"
  "/media/1/edit drupal"
  "/media-library drupal"
  "/media/oembed drupal"
  "/paragraphs_blokkli/x drupal"
  "/paragraphs_blokkli_graphql/prefix drupal"
  "/admin/config/content/blokkli drupal"
  "/layout_builder/x drupal"
  "/file/progress/1 drupal"
  "/sites/default/files/x.jpg drupal"
  "/system/files/x drupal"
  "/entity_reference_autocomplete/x drupal"
  "/.well-known/change-password drupal"
  "/blokkli-sandbox/login/x drupal"
)

# A sandbox that doesn't exist: nginx's static page, whatever the path.
unknown_sandbox="${base/:\/\//://zz99.}"
sandbox_routes=(
  "/ sandbox-unknown"
  "/en/graphql sandbox-unknown"
  "/_nuxt/x.js sandbox-unknown"
)

# Files, with the expected status: a sandbox's files only on its own host (none
# on the default site), PHP never from them and only from Drupal's front
# controllers, and none of Drupal's source files. PHP-FPM's status page only
# from inside the container.
file_routes=(
  "/phpstatus nginx 404"
  "/sites/default/files/sandboxes/zz98/x.jpg nginx 404"
  "/sites/default/files/x.php drupal 403"
  "/core/install.php drupal 200"
  "/sites/default/settings.php drupal 404"
  "/core/tests/bootstrap.php drupal 404"
  "/core/core.services.yml drupal 403"
  "/core/composer.json drupal 403"
  "/core/modules/system/templates/page.html.twig drupal 403"
  "/modules/custom/blokkli_sandbox/blokkli_sandbox.info.yml drupal 403"
  "/core/misc/drupal.js drupal 200"
  "/core/misc/druplicon.png drupal 200"
)

# Mutations, posted with a content type: only JSON reaches the middleware.
# nginx decodes the path before it compares it.
mutation_routes=(
  "application/json /api/graphql_middleware/mutation/x nuxt"
  "application/json;charset=UTF-8 /api/graphql_middleware/mutation/x nuxt"
  "text/plain /api/graphql_middleware/mutation/x nginx 415"
  "application/x-www-form-urlencoded /api/graphql_middleware/mutation/x nginx 415"
  "multipart/form-data;boundary=x /api/graphql_middleware/mutation/x nginx 415"
  "text/plain /api/graphql_middleware/%6Dutation/x nginx 415"
)

# The control app: every path, Drupal's included.
control="${base/:\/\/blokkli./://blokkli-control.}"
control_routes=(
  "/ control"
  "/de control"
  "/admin control"
  "/api/claim control"
  "/access/x control"
  "/user/login control"
)

failed=0
# Compares the upstream and, if given, the status. The fourth argument labels
# the request (the URL without one); further arguments go to curl.
check() {
  local url="$1" expected="$2" status="${3:-}" label="${4:-${1#https://}}" headers actual code
  headers=$(curl -sk -o /dev/null -D - --max-time 10 "${@:5}" "$url" | tr -d '\r')
  actual=$(awk -F': ' 'tolower($1) == "x-blokkli-upstream" { print $2 }' <<<"$headers")
  code=$(awk 'NR == 1 { print $2 }' <<<"$headers")
  if [ "$actual" = "$expected" ] && { [ -z "$status" ] || [ "$code" = "$status" ]; }; then
    printf '  ok    %-50s %s\n' "$label" "$actual${status:+ $code}"
  else
    printf '  FAIL  %-50s expected %s, got %s\n' "$label" "$expected${status:+ $status}" "${actual:-nothing}${status:+ $code}"
    failed=1
  fi
}

for route in "${routes[@]}"; do
  check "$base${route% *}" "${route##* }"
done
for route in "${file_routes[@]}"; do
  read -r path upstream status <<<"$route"
  check "$base$path" "$upstream" "$status"
done
for route in "${mutation_routes[@]}"; do
  read -r type path upstream status <<<"$route"
  check "$base$path" "$upstream" "$status" "POST $path ($type)" --data '{}' -H "Content-Type: $type"
done
for route in "${sandbox_routes[@]}"; do
  check "$unknown_sandbox${route% *}" "${route##* }"
done
for route in "${control_routes[@]}"; do
  check "$control${route% *}" "${route##* }"
done

exit $failed
