{
    "name": "blokkli/drupal",
    "description": "The Drupal site behind the blökkli playground and sandbox.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "name": "paragraphs_blokkli",
            "type": "path",
            "url": "paragraphs_blokkli",
            "options": {
                "symlink": true,
                "versions": {
                    "drupal/paragraphs_blokkli": "2.0.x-dev"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7",
        "deeplcom/deepl-php": "^1.18",
        "drupal/admin_toolbar": "^3.6",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/environment_indicator": "^4.0",
        "drupal/focal_point": "^2.1",
        "drupal/frontend_routing": "^1.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/graphql": "^5",
        "drupal/graphql_core_schema": "^1.0",
        "drupal/masquerade": "^2.0@beta",
        "drupal/menu_breadcrumb": "~2.0",
        "drupal/office_hours": "^1.29",
        "drupal/paragraphs": "^1.23",
        "drupal/paragraphs_blokkli": "2.0.x-dev",
        "drupal/pathauto": "^1.6",
        "drupal/scheduler": "^2.3",
        "drupal/search_api": "^1.41",
        "drupal/texts": "^1.0",
        "drupal/token": "^1.5",
        "drupal/token_or": "^2.1",
        "drupal/translatable_config_pages": "^1.0",
        "drupal/view_unpublished": "^1.4",
        "drush/drush": "^13",
        "twig/twig": "~3.29.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "symfony/runtime": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.editorconfig": false,
                "[project-root]/.gitattributes": false,
                "[project-root]/recipes/README.txt": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/core": {
                "drupal#1255092: The front page's URL is /, not its node's alias, e.g. in the language switcher (from Winterthur)": "https://www.drupal.org/files/issues/2022-03-31/1255092-41.patch",
                "drupal#3580733: PHP 8.5, hasTranslation() with a NULL langcode, e.g. the status field on /admin/people (from Winterthur)": "patches/core-3580733-php85-has-translation-null-langcode.patch"
            },
            "drupal/menu_breadcrumb": {
                "The breadcrumb over GraphQL: the active trail cache context is the /graphql route's, so the second request gets a wrong breadcrumb (from blokkli_starterkit)": "patches/menu_breadcrumb-graphql-cache-context.patch",
                "menu_breadcrumb#3578830: PHP 8.5, (bool) instead of (boolean) casts (menu_breadcrumb!40)": "patches/menu_breadcrumb-3578830-php85-boolean-cast.diff"
            },
            "drupal/pathauto": {
                "PHP 8.4+: getPatternByEntity() doesn't use a null entity id as an array key (from blokkli_starterkit)": "patches/pathauto-php84-null-entity-id-array-key.patch"
            },
            "drupal/scheduler": {
                "scheduler#3312200: Paragraph scheduler plugin": "https://www.drupal.org/files/issues/2026-06-15/3312200-paragraph-scheduler.diff"
            },
            "mglaman/phpstan-drupal": {
                "Extension discovery skips directories named web, like file_scan_ignore_directories in settings.php: the paragraphs_blokkli checkout builds its own test site there": "patches/phpstan-drupal-ignore-web-directories.patch"
            }
        }
    },
    "require-dev": {
        "drupal/coder": "^9.0",
        "mglaman/phpstan-drupal": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    }
}
