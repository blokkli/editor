<?php

/**
 * @file
 * Install, update and uninstall functions for blokkli_playground_test.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\paragraphs_blokkli\Entity\PbEntityMapping;
use Drupal\paragraphs_blokkli\Model\ParagraphMapping;

/**
 * Implements hook_install().
 *
 * Allows the widget on detail pages. No field of the site allows it, so only
 * E2E sandboxes have widgets.
 *
 * Every translation of a news item shares its status and the scheduler's
 * dates, as the content translation settings allow. The site gives each
 * translation its own.
 *
 * A teaser's link and media, and a news item's hero image, differ per
 * language, so the editor asks whether a drop changes them in all languages.
 * On the site, links and media are shared.
 *
 * A document can go into the widget's links, which take several values, as
 * into its media.
 */
function blokkli_playground_test_install(): void {
  $field = FieldConfig::loadByName('node', 'page', 'field_paragraphs');
  assert($field instanceof FieldConfig);
  $settings = $field->getSetting('handler_settings');
  $settings['target_bundles']['widget'] = 'widget';
  $field->setSetting('handler_settings', $settings);
  $field->save();

  $definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  foreach (['status', 'publish_on', 'unpublish_on'] as $name) {
    $definitions[$name]->getConfig('news')->setTranslatable(FALSE)->save();
  }

  foreach ([
    ['paragraph', 'teaser', 'field_link'],
    ['paragraph', 'teaser', 'field_media'],
    ['node', 'news', 'field_hero_image'],
  ] as [$entityType, $bundle, $fieldName]) {
    $field = FieldConfig::loadByName($entityType, $bundle, $fieldName);
    assert($field instanceof FieldConfig);
    $field->setTranslatable(TRUE)->save();
  }

  $mapping = PbEntityMapping::load('media__document');
  assert($mapping instanceof PbEntityMapping);
  $mapping->setMappings([
    ...$mapping->getMappings(),
    new ParagraphMapping('widget', 'field_link_items'),
  ]);
  $mapping->save();
}
